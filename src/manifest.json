{
  "manifest_version": 3,
  "name": "Collection to Play",
  "version": "0.2.3",
  "description": "Abra álbuns da sua coleção no streaming escolhido. Integração inicial com Libib.",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "identity",
    "storage",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://accounts.spotify.com/*",
    "https://api.spotify.com/*",
    "https://music.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Collection to Play",
    "default_popup": "setup.html"
  },
  "options_ui": {
    "page": "setup.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.libib.com/library*"
      ],
      "js": [
        "library.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "album-panel.html",
        "library.css",
        "spotify-icon.svg",
        "youtube-music-icon.png"
      ],
      "matches": [
        "https://www.libib.com/*"
      ]
    }
  ]
}
