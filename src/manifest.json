{
  "manifest_version": 3,
  "name": "Collection to Play",
  "version": "0.4.1",
  "description": "Abra álbuns da sua coleção no streaming escolhido. Integração inicial com Libib.",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "identity",
    "storage",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://api.themoviedb.org/*",
    "https://image.tmdb.org/*",
    "https://accounts.spotify.com/*",
    "https://api.spotify.com/*",
    "https://api.deezer.com/*",
    "https://cdn-images.dzcdn.net/*",
    "https://itunes.apple.com/*",
    "https://*.mzstatic.com/*",
    "https://music.youtube.com/*",
    "https://i.scdn.co/*",
    "https://lh3.googleusercontent.com/*",
    "https://yt3.googleusercontent.com/*",
    "https://i.ytimg.com/*",
    "https://ws.audioscrobbler.com/*",
    "https://lastfm.freetls.fastly.net/*",
    "https://lastfm-img2.akamaized.net/*"
  ],
  "background": {
    "service_worker": "entrypoints/background.ts",
    "type": "module"
  },
  "action": {
    "default_title": "Collection to Play",
    "default_popup": "setup.html",
    "default_icon": {
      "16": "assets/collection-to-play-icon-16.png",
      "32": "assets/collection-to-play-icon-32.png",
      "48": "assets/collection-to-play-icon-48.png",
      "128": "assets/collection-to-play-icon-128.png"
    }
  },
  "options_ui": {
    "page": "setup.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.libib.com/library*"
      ],
      "js": [
        "entrypoints/libib-native-entry.ts"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.libib.com/library*"
      ],
      "js": [
        "entrypoints/library.ts"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "album-panel.html",
        "metadata-editor.html",
        "library.css",
        "assets/spotify-icon.svg",
        "assets/itunes-icon.svg",
        "assets/deezer-icon.svg",
        "assets/youtube-music-icon.png",
        "ui.css",
        "assets/lastfm-icon.svg"
      ],
      "matches": [
        "https://www.libib.com/*"
      ]
    }
  ],
  "icons": {
    "16": "assets/collection-to-play-icon-16.png",
    "32": "assets/collection-to-play-icon-32.png",
    "48": "assets/collection-to-play-icon-48.png",
    "128": "assets/collection-to-play-icon-128.png"
  }
}
